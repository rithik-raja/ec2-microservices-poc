{
  "name": "simple-threads-monorepo",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "sh -c 'npm run dev:frontend & npm run dev:backend & wait'",
    "dev:frontend": "npm run dev --workspace frontend",
    "dev:backend": "npm run dev --workspace backend",
    "build": "npm run build:frontend && npm run build:backend",
    "build:frontend": "npm run build --workspace frontend",
    "build:backend": "echo \"No backend build step configured\"",
    "start": "sh -c 'npm run start:frontend & npm run start:backend & wait'",
    "start:frontend": "npm run start --workspace frontend",
    "start:backend": "npm run start --workspace backend",
    "lint": "npm run lint --workspace frontend",
    "test": "npm run test --workspace backend",
    "clean": "find . -name node_modules -type d -prune -exec rm -rf '{}' +"
  }
}
